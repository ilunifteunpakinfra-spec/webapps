# ============================================
# ILUNI FTE WebApps - .gitignore
# Next.js (App Router) + Supabase + Tailwind CSS + shadcn/ui
# ============================================

# ---------- SENSITIVE / SECRETS ----------
# Never commit environment variables or API keys
.env
.env.*
!.env.example
.mcp.json

# ---------- REFERENCE / SOURCE MATERIALS ----------
# Local reference documents, images, archives (not part of source code)
.resource/

# ---------- DEPENDENCIES ----------
node_modules/
.pnp
.pnp.js
.pnp.cjs
.pnp.loader.mjs

# ---------- NEXT.JS BUILD OUTPUT ----------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---------- SUPABASE ----------
# Local Supabase development files
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.local

# ---------- TESTING / COVERAGE ----------
coverage/
.nyc_output/
*.lcov
*.lcov.info

# ---------- LOGS & DEBUG ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- CACHE & TEMP ----------
.cache/
.temp/
.tmp/
*.tmp
*.swp
*.swo
*~
.DS_Store

# ---------- EDITOR / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- OS FILES ----------
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- MISC ----------
# Compiled / generated files
*.pyc
__pycache__/
*.class
*.jar

# TypeScript declaration files (generated)
*.d.ts.map
*.js.map

# Vercel
.vercel/

# Sentry
.sentryclirc